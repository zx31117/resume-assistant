# ============================================================================
# 运行数据根目录（V1.4）：所有可变数据统一从该目录派生。
# - 默认不设置时位于 Git checkout 外的用户级目录：
#   Windows: %LOCALAPPDATA%\ResumeAssistant
#   macOS:   ~/Library/Application Support/ResumeAssistant
#   Linux:   ~/.local/share/resume-assistant
# - 若要强制指向特定目录（迁移期回滚、测试），请取消注释并修改下面一行：
# RESUME_DATA_DIR=./local-data
# ============================================================================

# 豆包 / 火山方舟
ARK_API_KEY=<your-ark-api-key>
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-seed-evolving
EMBEDDING_MODEL=doubao-embedding-vision-251215

# ----------------------------------------------------------------------------
# 以下存储/输出路径默认不设置，自动派生为 RESUME_DATA_DIR 下的子目录：
#   ${RESUME_DATA_DIR}/database/app.db
#   ${RESUME_DATA_DIR}/vectorstore/chroma
#   ${RESUME_DATA_DIR}/output
# 仅在迁移回滚或调试时显式设置（可使用绝对路径或相对当前 cwd）。
# ----------------------------------------------------------------------------
# SQLITE_PATH=./data/app.db
# CHROMA_PATH=./data/chroma
# DOCX_OUTPUT_DIR=./output

# 应用
APP_HOST=127.0.0.1
APP_PORT=8000
